# Copy to .env.local to override the defaults for local work.

# Base URL of the backend REST API (path if same domain / proxied, or a full URL).
VITE_API_BASE_URL=/api
# Prefix for uploaded-file paths the API returns (/uploads/...). Leave empty when proxied.
VITE_ASSET_BASE_URL=
# Dev server only: where /api and /uploads are proxied to.
VITE_PROXY_TARGET=http://localhost:5000
# true = built-in in-memory demo API (no backend needed), false = real backend
VITE_USE_MOCK=false

VITE_APP_NAME=Serene EduHealth
# Shown in the "Help" popover
VITE_SUPPORT_EMAIL=support@serene-eduhealth.com
VITE_SUPPORT_PHONE=+234 800 000 0000
